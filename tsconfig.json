{
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true, "strict": true,
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js"]
}
